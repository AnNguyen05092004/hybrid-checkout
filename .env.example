# Copy to .env (never commit .env). Read by docker compose, backend and inference.
ENV=dev
POSTGRES_PASSWORD=hybrid
DATABASE_URL=postgresql+psycopg://hybrid:hybrid@postgres:5432/hybrid_checkout
REDIS_URL=redis://redis:6379/0

# openssl rand -hex 32
JWT_SECRET=change-me
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET_PREFIX=hybrid

INFERENCE_URL=http://inference:9100
# Shared by backend and inference; openssl rand -hex 32
INFERENCE_TOKEN=change-me
DEVICE=cpu
