// HybridCheckout data model, PostgreSQL 16 (docs/05-data-model.md).
// Source of truth for the schema. scripts/build_schema.sh turns it into schema.sql and appends
// extras.sql (partial indexes, views, triggers, default settings) that DBML cannot express.
// Conventions: snake_case, plural table names, bigint identity keys, money in VND as bigint,
// timestamps as timestamptz, boxes as x/y/w/h normalised to 0..1. One store per installation.

Project hybrid_checkout {
  database_type: 'PostgreSQL'
  Note: 'Hybrid checkout: the barcode decides the bill, the camera checks the tray.'
}

TableGroup people_and_counters {
  users
  counters
  shifts
}

TableGroup catalog {
  categories
  skus
}

TableGroup checkout {
  transactions
  transaction_lines
  tray_captures
  detections
  alerts
  alert_detections
  manager_approvals
}

TableGroup batch_data {
  import_batches
  sku_samples
  label_tasks
  annotations
}

TableGroup model {
  jobs
  model_versions
  model_version_skus
  model_deployments
  model_confusions
  threshold_configs
}

TableGroup system {
  settings
  audit_logs
}

// ---------------------------------------------------------------- enums

Enum user_role {
  CASHIER
  STORE_MANAGER
  ML_ENGINEER
  ADMIN
}

Enum checkout_mode {
  VERIFY [note: 'Kiểm tra chéo: photo when the items are put down, scan everything, compare at Pay']
  FAST [note: 'Làn nhanh: the camera proposes, the cashier scans uncertain items']
}

Enum transaction_status {
  OPEN
  PAID
  CANCELLED
}

Enum payment_method {
  CASH
  CARD
  TRANSFER
}

Enum line_source {
  BARCODE
  CAMERA
}

Enum capture_status {
  SUCCEEDED
  FAILED
}

Enum alert_type {
  UNSCANNED_ITEM
  SUSPECTED_SWAP
  SCANNED_NOT_SEEN
}

Enum alert_severity {
  HIGH
  MEDIUM
  LOW
}

Enum alert_resolution {
  OPEN
  SCANNED [note: 'Closed by scanning the missing or the right item']
  FALSE_ALARM [note: 'Cashier confirmed a model error, with a reason (BR-04)']
  AUTO_CLOSED [note: 'Non-blocking alert still open at payment']
}

Enum review_result {
  ALERT_CORRECT [note: 'The alert was right: the false-alarm claim was wrong']
  MODEL_ERROR
  SUSPECTED_FRAUD
}

Enum approval_action {
  CANCEL_TRANSACTION
  SKIP_TRAY_CHECK
}

Enum removal_reason {
  CUSTOMER_DECLINED [note: 'Customer no longer wants the item']
  WRONG_ITEM [note: 'Wrong code scanned']
  DUPLICATE_SCAN
}

Enum batch_status {
  DRAFT
  COLLECTING
  TRAINING
  PENDING_REVIEW
  DEPLOYED
}

Enum sample_status {
  PENDING
  ACCEPTED
  REJECTED
}

Enum label_source {
  NEW_SKU_SALE [note: 'Tray of a sale that scanned a SKU of the batch, queued by the system']
  HARD_IMAGE [note: 'Sent by a person from a transaction or from monitoring']
}

Enum label_status {
  PENDING
  LABELED
  SKIPPED
}

Enum dataset_split {
  VAL
  TRAIN
}

Enum annotation_origin {
  MODEL_PROPOSAL
  MANUAL
}

Enum job_type {
  COMPOSITE [note: 'Paste accepted cutouts onto tray backgrounds']
  TRAIN
  EVAL
}

Enum job_status {
  QUEUED
  RUNNING
  EVALUATING
  SUCCEEDED
  FAILED
  CANCELLED
}

Enum model_status {
  PENDING_REVIEW
  ACTIVE
  RETIRED
  REJECTED
}

Enum deployment_action {
  DEPLOY
  ROLLBACK
}

// ---------------------------------------------------------------- people and counters

Table users {
  id bigint [pk, increment]
  email varchar(254) [not null, unique]
  full_name varchar(100) [not null]
  role user_role [not null]
  password_hash text [not null]
  pin_hash text [note: 'Store managers only: hashed 6-digit PIN (UC12). The counter checks the PIN against every active manager, so two managers may not share one']
  is_active boolean [not null, default: true]
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `email = lower(email)` [name: 'ck_users_email_lower']
    `pin_hash IS NULL OR role = 'STORE_MANAGER'` [name: 'ck_users_pin_manager_only']
  }
}

Table counters {
  id bigint [pk, increment]
  code varchar(10) [not null, unique, note: 'Q1, Q2, …']
  name varchar(50) [not null]
  camera_name varchar(50) [not null]
  camera_url varchar(255) [not null, note: 'Snapshot URL of the IP camera; the backend pulls the tray image from it']
  camera_last_seen_at timestamptz [note: 'Heartbeat; the camera is online when seen in the last 30 seconds']
  pin_failed_attempts smallint [not null, default: 0, note: 'Wrong manager PINs at this counter; the PIN does not say which manager was meant']
  pin_locked_until timestamptz [note: '3 wrong PINs lock PIN entry at this counter for 5 minutes (US08)']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `pin_failed_attempts >= 0` [name: 'ck_counters_pin_attempts']
  }
}

Table shifts {
  id bigint [pk, increment]
  counter_id bigint [not null, ref: > counters.id]
  cashier_id bigint [not null, ref: > users.id]
  opened_at timestamptz [not null, default: `now()`]
  opening_cash_vnd bigint [not null]
  closed_at timestamptz
  counted_cash_vnd bigint [note: 'Cash counted at close; the expected amount is derived from cash payments']

  indexes {
    counter_id
    cashier_id
    opened_at
  }

  checks {
    `opening_cash_vnd >= 0 AND (counted_cash_vnd IS NULL OR counted_cash_vnd >= 0)` [name: 'ck_shifts_cash']
    `(closed_at IS NULL) = (counted_cash_vnd IS NULL)` [name: 'ck_shifts_close']
    `closed_at IS NULL OR closed_at >= opened_at` [name: 'ck_shifts_time']
  }
}

// ---------------------------------------------------------------- catalog

Table categories {
  id bigint [pk, increment]
  code varchar(40) [not null, unique, note: 'e.g. puffed_food; suspected swaps compare SKUs of one category']
  name varchar(60) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table skus {
  id bigint [pk, increment]
  barcode varchar(14) [not null, unique, note: 'EAN-13; demo SKUs use the in-store prefix 200 (BR-14)']
  name varchar(150) [not null]
  category_id bigint [not null, ref: > categories.id]
  price_vnd bigint [not null, note: 'Current price; lines keep the price at the time of sale']
  is_selling boolean [not null, default: true]
  batch_id bigint [ref: > import_batches.id, note: 'Batch that teaches this SKU to the camera; NULL = not in a batch yet']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    category_id
    batch_id
  }

  checks {
    `barcode ~ '^[0-9]{8,14}$'` [name: 'ck_skus_barcode']
    `price_vnd > 0` [name: 'ck_skus_price']
  }
}

// ---------------------------------------------------------------- checkout

Table transactions {
  id bigint [pk, increment]
  code varchar(20) [not null, unique, note: 'Receipt number, e.g. GD1000']
  shift_id bigint [not null, ref: > shifts.id, note: 'Gives the counter and the cashier']
  mode checkout_mode [not null]
  status transaction_status [not null, default: 'OPEN', note: 'Waiting for alerts / ready to pay are derived from the open HIGH alerts']
  total_vnd bigint [note: 'Set at payment: sum of the lines not removed']
  payment_method payment_method
  cash_received_vnd bigint
  started_at timestamptz [not null, default: `now()`, note: 'First scan; the tray is photographed now, while the items are still on the counter']
  reconciled_at timestamptz [note: 'Cross-check: first press of Pay, photo compared with the scans (UC05). From then on every scan or removal re-runs it']
  closed_at timestamptz [note: 'Paid or cancelled']

  indexes {
    shift_id
    started_at
  }

  checks {
    `(status = 'OPEN') = (closed_at IS NULL)` [name: 'ck_transactions_closed']
    `(status = 'PAID') = (payment_method IS NOT NULL AND total_vnd IS NOT NULL)` [name: 'ck_transactions_paid']
    `(payment_method = 'CASH') = (cash_received_vnd IS NOT NULL)` [name: 'ck_transactions_cash']
    `total_vnd IS NULL OR total_vnd >= 0` [name: 'ck_transactions_total']
    `cash_received_vnd IS NULL OR cash_received_vnd >= total_vnd` [name: 'ck_transactions_change']
  }
}

Table transaction_lines {
  id bigint [pk, increment]
  transaction_id bigint [not null]
  sku_id bigint [not null, ref: > skus.id]
  qty integer [not null]
  unit_price_vnd bigint [not null, note: 'Price at the time of sale (BR-06)']
  source line_source [not null]
  detection_id bigint [unique, ref: > detections.id, note: 'Fast lane: box the camera added this line from']
  added_at timestamptz [not null, default: `now()`]
  removed_at timestamptz [note: 'Deleted lines are kept for the post-review (BR-17)']
  removed_by bigint [ref: > users.id, note: 'Cashier who deleted the line, without a PIN (BR-05)']
  removal_reason removal_reason

  indexes {
    transaction_id
    sku_id
  }

  checks {
    `qty > 0 AND unit_price_vnd > 0` [name: 'ck_transaction_lines_amount']
    `(source = 'CAMERA') = (detection_id IS NOT NULL)` [name: 'ck_transaction_lines_camera_source']
    `(removed_at IS NULL) = (removed_by IS NULL) AND (removed_by IS NULL) = (removal_reason IS NULL)` [name: 'ck_transaction_lines_removal']
  }
}

Table tray_captures {
  id bigint [pk, increment]
  transaction_id bigint [not null]
  status capture_status [not null]
  model_version_id bigint [ref: > model_versions.id, note: 'Model that ran the detection (BR-06)']
  image_key varchar(255) [note: 'Object storage key of the tray image']
  latency_ms integer
  error varchar(200)
  captured_at timestamptz [not null, default: `now()`]
  image_purged_at timestamptz [note: 'Image deleted after 30 days (BR-13); detections and alerts stay']

  indexes {
    transaction_id
    model_version_id
  }

  checks {
    `status = 'FAILED' OR (model_version_id IS NOT NULL AND image_key IS NOT NULL)` [name: 'ck_tray_captures_succeeded']
    `status = 'SUCCEEDED' OR error IS NOT NULL` [name: 'ck_tray_captures_failed']
    `latency_ms IS NULL OR latency_ms >= 0` [name: 'ck_tray_captures_latency']
  }
}

Table detections {
  id bigint [pk, increment]
  capture_id bigint [not null]
  sku_id bigint [not null, ref: > skus.id, note: 'SKU predicted by the model']
  score real [not null]
  box_x real [not null]
  box_y real [not null]
  box_w real [not null]
  box_h real [not null]
  confirmed_sku_id bigint [ref: > skus.id, note: 'Fast lane: SKU scanned to confirm an uncertain box; differs from sku_id when corrected']
  confirmed_at timestamptz

  indexes {
    capture_id
    sku_id
    (id, capture_id) [unique, name: 'ux_detections_id_capture', note: 'Target of alert_detections: the box belongs to the alert capture']
  }

  checks {
    `score BETWEEN 0 AND 1` [name: 'ck_detections_score']
    `box_x >= 0 AND box_y >= 0 AND box_w > 0 AND box_h > 0 AND box_x + box_w <= 1 AND box_y + box_h <= 1` [name: 'ck_detections_box']
    `(confirmed_sku_id IS NULL) = (confirmed_at IS NULL)` [name: 'ck_detections_confirmed']
  }
}

Table alerts {
  id bigint [pk, increment]
  capture_id bigint [not null, note: 'Tray photo the scans were compared with; gives the transaction']
  type alert_type [not null]
  severity alert_severity [not null]
  seen_sku_id bigint [ref: > skus.id, note: 'SKU the camera saw: the unscanned item, or the real item of a swap']
  scanned_sku_id bigint [ref: > skus.id, note: 'SKU that was scanned: swap, or scanned but not seen']
  qty integer [not null, default: 1]
  value_vnd bigint [not null, default: 0, note: 'Money at risk for the store']
  resolution alert_resolution [not null, default: 'OPEN']
  reason varchar(200) [note: 'Cashier reason for a false alarm (BR-04)']
  resolved_by bigint [ref: > users.id, note: 'Cashier who scanned or confirmed the false alarm']
  resolved_at timestamptz
  review_result review_result [note: 'Post-review of a false alarm by the manager (UC14, BR-17)']
  review_note varchar(500)
  reviewed_by bigint [ref: > users.id]
  reviewed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    created_at
    (id, capture_id) [unique, name: 'ux_alerts_id_capture', note: 'Target of alert_detections']
  }

  checks {
    `(type = 'UNSCANNED_ITEM' AND seen_sku_id IS NOT NULL AND scanned_sku_id IS NULL AND severity = 'HIGH') OR (type = 'SUSPECTED_SWAP' AND seen_sku_id IS NOT NULL AND scanned_sku_id IS NOT NULL AND severity <> 'LOW') OR (type = 'SCANNED_NOT_SEEN' AND seen_sku_id IS NULL AND scanned_sku_id IS NOT NULL AND severity = 'LOW')` [name: 'ck_alerts_shape']
    `qty > 0 AND value_vnd >= 0` [name: 'ck_alerts_amount']
    `resolution <> 'FALSE_ALARM' OR reason IS NOT NULL` [name: 'ck_alerts_false_alarm']
    `(severity = 'HIGH' AND resolution <> 'AUTO_CLOSED') OR severity = 'MEDIUM' OR (severity = 'LOW' AND resolution IN ('OPEN', 'AUTO_CLOSED'))` [name: 'ck_alerts_resolution_by_severity']
    `(resolution IN ('SCANNED', 'FALSE_ALARM')) = (resolved_by IS NOT NULL)` [name: 'ck_alerts_resolver']
    `(resolution = 'OPEN') = (resolved_at IS NULL)` [name: 'ck_alerts_resolved_at']
    `(review_result IS NULL) = (reviewed_by IS NULL) AND (reviewed_by IS NULL) = (reviewed_at IS NULL)` [name: 'ck_alerts_review']
    `review_result IS NULL OR resolution = 'FALSE_ALARM'` [name: 'ck_alerts_review_false_alarm']
  }
}

Table alert_detections [note: 'Boxes that raised an alert, highlighted on the tray image. capture_id makes both sides belong to one tray photo'] {
  alert_id bigint [not null]
  detection_id bigint [not null]
  capture_id bigint [not null]

  indexes {
    (alert_id, detection_id) [pk]
    detection_id
  }
}

Table manager_approvals [note: 'Manager PIN confirmations at the counter: cancel a transaction, skip the tray check (UC12, BR-05)'] {
  id bigint [pk, increment]
  transaction_id bigint [not null]
  action approval_action [not null]
  manager_id bigint [not null, ref: > users.id]
  requested_by bigint [not null, ref: > users.id, note: 'Cashier at the counter']
  reason varchar(200) [not null]
  approved_at timestamptz [not null, default: `now()`]

  indexes {
    transaction_id
  }

  checks {
    `manager_id <> requested_by` [name: 'ck_manager_approvals_other_person']
  }
}

// ---------------------------------------------------------------- batch data

Table import_batches {
  id bigint [pk, increment]
  seq_no smallint [not null, unique, note: 'Shown as "Đợt 5"; also the order in which the model learns batches']
  name varchar(100) [not null]
  status batch_status [not null, default: 'DRAFT']
  created_by bigint [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  deployed_at timestamptz
  data_purged_at timestamptz [note: 'Sample photos and TRAIN real images deleted 14 days after deploy; VAL images stay for the gates of later versions (BR-13)']

  checks {
    `seq_no > 0` [name: 'ck_import_batches_seq']
    `(status = 'DEPLOYED') = (deployed_at IS NOT NULL)` [name: 'ck_import_batches_deployed']
  }
}

Table sku_samples [note: 'Sample photos of a new SKU and their background-removed cutouts (UC17)'] {
  id bigint [pk, increment]
  sku_id bigint [not null, ref: > skus.id]
  photo_key varchar(255) [not null]
  cutout_key varchar(255) [note: 'NULL while background removal runs']
  mask_quality real [note: 'From the background-removal model; low values are flagged for a closer look']
  status sample_status [not null, default: 'PENDING']
  uploaded_by bigint [not null, ref: > users.id]
  uploaded_at timestamptz [not null, default: `now()`]
  reviewed_by bigint [ref: > users.id]
  reviewed_at timestamptz

  indexes {
    (sku_id, status)
  }

  checks {
    `mask_quality IS NULL OR mask_quality BETWEEN 0 AND 1` [name: 'ck_sku_samples_quality']
    `status = 'PENDING' OR cutout_key IS NOT NULL` [name: 'ck_sku_samples_reviewed_cutout']
    `(status = 'PENDING') = (reviewed_by IS NULL) AND (reviewed_by IS NULL) = (reviewed_at IS NULL)` [name: 'ck_sku_samples_review']
  }
}

Table label_tasks [note: 'Real tray images labelled with the assistant (UC18)'] {
  id bigint [pk, increment]
  batch_id bigint [ref: > import_batches.id, note: 'NULL: hard image waiting for the next batch']
  capture_id bigint [not null, unique, ref: > tray_captures.id, note: 'Source image; one task per image']
  source label_source [not null]
  image_key varchar(255) [not null, note: 'Copy in the dataset store, so the 30-day transaction retention does not delete it']
  status label_status [not null, default: 'PENDING']
  split dataset_split [note: 'VAL first; TRAIN only above the BR-11 target, when the ML engineer opts in (BR-16)']
  proposals_total smallint [not null, default: 0, note: 'Old-SKU boxes proposed by the model']
  proposals_accepted smallint [not null, default: 0]
  skip_reason varchar(200)
  queued_by bigint [ref: > users.id, note: 'NULL: queued by the system']
  queued_at timestamptz [not null, default: `now()`]
  completed_by bigint [ref: > users.id, note: 'Labelled or skipped by']
  completed_at timestamptz

  indexes {
    (batch_id, status)
  }

  checks {
    `(source = 'HARD_IMAGE') = (queued_by IS NOT NULL)` [name: 'ck_label_tasks_source']
    `(status = 'LABELED') = (split IS NOT NULL)` [name: 'ck_label_tasks_split']
    `(status = 'SKIPPED') = (skip_reason IS NOT NULL)` [name: 'ck_label_tasks_skip']
    `(status = 'PENDING') = (completed_by IS NULL) AND (completed_by IS NULL) = (completed_at IS NULL)` [name: 'ck_label_tasks_completed']
    `status = 'PENDING' OR batch_id IS NOT NULL` [name: 'ck_label_tasks_batch']
    `proposals_accepted BETWEEN 0 AND proposals_total` [name: 'ck_label_tasks_proposals']
  }
}

Table annotations [note: 'Accepted boxes only: a proposal becomes a label once a person accepts it (BR-12)'] {
  id bigint [pk, increment]
  label_task_id bigint [not null]
  sku_id bigint [not null, ref: > skus.id]
  box_x real [not null]
  box_y real [not null]
  box_w real [not null]
  box_h real [not null]
  origin annotation_origin [not null]
  proposal_score real [note: 'Score of the accepted model proposal']
  created_by bigint [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    label_task_id
    sku_id
  }

  checks {
    `box_x >= 0 AND box_y >= 0 AND box_w > 0 AND box_h > 0 AND box_x + box_w <= 1 AND box_y + box_h <= 1` [name: 'ck_annotations_box']
    `(origin = 'MODEL_PROPOSAL') = (proposal_score IS NOT NULL)` [name: 'ck_annotations_origin']
    `proposal_score IS NULL OR proposal_score BETWEEN 0 AND 1` [name: 'ck_annotations_score']
  }
}

// ---------------------------------------------------------------- model

Table jobs [note: 'Background work of a batch: composites, training, evaluation (UC19, UC20)'] {
  id bigint [pk, increment]
  type job_type [not null]
  batch_id bigint [not null, ref: > import_batches.id]
  status job_status [not null, default: 'QUEUED']
  progress integer [not null, default: 0]
  progress_total integer [not null, note: 'Epochs for training, images for composites']
  params jsonb [not null, default: `'{}'::jsonb`, note: 'e.g. {"epochs": 16, "mix_real_images": 2, "composite_job_id": 7}']
  output_uri varchar(255) [note: 'Composite dataset folder or checkpoint folder']
  output_count integer [note: 'Composites created']
  gpu_hours numeric(6,2) [not null, default: 0]
  log_uri varchar(255)
  error text
  created_by bigint [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  started_at timestamptz
  finished_at timestamptz

  indexes {
    (batch_id, type)
    (id, batch_id) [unique, name: 'ux_jobs_id_batch', note: 'Target of model_versions: the version belongs to the batch of its training job']
  }

  checks {
    `progress BETWEEN 0 AND progress_total` [name: 'ck_jobs_progress']
    `status IN ('QUEUED', 'CANCELLED') OR started_at IS NOT NULL` [name: 'ck_jobs_started']
    `status <> 'QUEUED' OR started_at IS NULL` [name: 'ck_jobs_queued']
    `(status IN ('SUCCEEDED', 'FAILED', 'CANCELLED')) = (finished_at IS NOT NULL)` [name: 'ck_jobs_finished']
    `status <> 'FAILED' OR error IS NOT NULL` [name: 'ck_jobs_error']
    `gpu_hours >= 0` [name: 'ck_jobs_gpu']
  }
}

Table model_versions {
  id bigint [pk, increment]
  code varchar(10) [not null, unique, note: 'v1, v2, …']
  name varchar(100) [not null]
  batch_id bigint [not null, ref: > import_batches.id, note: 'Last batch learned; the version also knows every earlier batch']
  train_job_id bigint [not null, unique]
  backbone varchar(60) [not null]
  checkpoint_uri varchar(255) [not null]
  status model_status [not null, default: 'PENDING_REVIEW']
  ap50 numeric(5,2) [not null, note: 'Metrics in %, on the real-image validation set (BR-09)']
  cacc numeric(5,2) [not null]
  forgetting numeric(5,2) [not null, note: 'Mean AP50 drop on earlier batches, points']
  miss_recall numeric(5,2) [not null]
  false_alarm_rate numeric(5,2) [not null, note: 'Alerted trays among trays scanned completely and correctly']
  swap_recall numeric(5,2) [not null]
  gate_passed boolean [not null]
  gate_report jsonb [not null, note: 'Each BR-09 condition: value, baseline of the running version, limit, passed']
  created_at timestamptz [not null, default: `now()`]
  rejected_by bigint [ref: > users.id]
  rejected_at timestamptz
  reject_reason varchar(300)

  checks {
    `ap50 BETWEEN 0 AND 100 AND cacc BETWEEN 0 AND 100 AND miss_recall BETWEEN 0 AND 100 AND false_alarm_rate BETWEEN 0 AND 100 AND swap_recall BETWEEN 0 AND 100` [name: 'ck_model_versions_metrics']
    `(status = 'REJECTED') = (rejected_by IS NOT NULL) AND (rejected_by IS NULL) = (rejected_at IS NULL)` [name: 'ck_model_versions_rejected']
  }
}

Table model_version_skus [note: 'Class map of a version: which SKUs it knows. A SKU is learned when the ACTIVE version lists it'] {
  model_version_id bigint [not null]
  sku_id bigint [not null, ref: > skus.id]
  class_index smallint [not null, note: 'Output index of the model head']

  indexes {
    (model_version_id, sku_id) [pk]
    (model_version_id, class_index) [unique]
  }
}

Table model_deployments [note: 'Every deploy and rollback, newest first in the UI (BR-07, BR-08)'] {
  id bigint [pk, increment]
  action deployment_action [not null]
  model_version_id bigint [not null, ref: > model_versions.id, note: 'Version put into service']
  previous_version_id bigint [ref: > model_versions.id, note: 'Version it replaced; NULL for the first deploy']
  gate_overridden boolean [not null, default: false]
  reason varchar(300) [note: 'Required for an override and for a rollback']
  performed_by bigint [not null, ref: > users.id]
  performed_at timestamptz [not null, default: `now()`]

  indexes {
    performed_at
  }

  checks {
    `NOT (gate_overridden OR action = 'ROLLBACK') OR reason IS NOT NULL` [name: 'ck_model_deployments_reason']
    `action = 'DEPLOY' OR NOT gate_overridden` [name: 'ck_model_deployments_override']
    `previous_version_id IS NULL OR previous_version_id <> model_version_id` [name: 'ck_model_deployments_change']
    `action = 'DEPLOY' OR previous_version_id IS NOT NULL` [name: 'ck_model_deployments_rollback_from']
  }
}

Table model_confusions [note: 'Most confused SKU pairs of a version on validation (L05)'] {
  model_version_id bigint [not null]
  true_sku_id bigint [not null, ref: > skus.id]
  predicted_sku_id bigint [not null, ref: > skus.id]
  pair_count integer [not null]

  indexes {
    (model_version_id, true_sku_id, predicted_sku_id) [pk]
  }

  checks {
    `true_sku_id <> predicted_sku_id AND pair_count > 0` [name: 'ck_model_confusions_pair']
  }
}

Table threshold_configs [note: 'Append-only history: the newest row per batch is in force; undo inserts the old values again (L06)'] {
  id bigint [pk, increment]
  batch_id bigint [not null, ref: > import_batches.id, note: 'Applies to the SKUs of this batch (BR-10)']
  low_threshold real [not null, note: 'Below: ignored. Between low and alert: drawn as uncertain only']
  alert_threshold real [not null, note: 'At or above: counts as seen and can raise alerts']
  auto_threshold real [not null, note: 'Fast lane: at or above, added to the cart without a scan']
  created_by bigint [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (batch_id, created_at)
  }

  checks {
    `0 <= low_threshold AND low_threshold < alert_threshold AND alert_threshold <= auto_threshold AND auto_threshold <= 1` [name: 'ck_threshold_configs_order']
  }
}

// ---------------------------------------------------------------- system

Table settings [note: 'Tunable rules (retention, gate, audit, data targets); defaults in extras.sql'] {
  key varchar(60) [pk]
  value jsonb [not null]
  description varchar(200) [not null]
  updated_by bigint [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]
}

Table audit_logs [note: 'Append-only: a trigger rejects UPDATE, DELETE and TRUNCATE (US27)'] {
  id bigint [pk, increment]
  occurred_at timestamptz [not null, default: `now()`]
  actor_id bigint [ref: > users.id, note: 'NULL: the system']
  action varchar(40) [not null, note: 'LOGIN, PIN_FAILED, FALSE_ALARM, DELETE_LINE, DEPLOY_MODEL, …']
  entity_type varchar(40) [note: 'transaction, sku, import_batch, model_version, …']
  entity_id bigint
  counter_id bigint [ref: > counters.id]
  detail jsonb [not null, default: `'{}'::jsonb`]

  indexes {
    occurred_at
    (actor_id, occurred_at)
    (entity_type, entity_id)
  }
}

// ---------------------------------------------------------------- references that cascade
// Rows that only exist as part of their parent are deleted with it; every other reference
// restricts, so history (transactions, versions, audit) is never removed by accident.

Ref: transaction_lines.transaction_id > transactions.id [delete: cascade]
Ref: tray_captures.transaction_id > transactions.id [delete: cascade]
Ref: detections.capture_id > tray_captures.id [delete: cascade]
Ref: alerts.capture_id > tray_captures.id [delete: cascade]
Ref: alert_detections.(alert_id, capture_id) > alerts.(id, capture_id) [delete: cascade]
Ref: alert_detections.(detection_id, capture_id) > detections.(id, capture_id) [delete: cascade]
Ref: manager_approvals.transaction_id > transactions.id [delete: cascade]
Ref: annotations.label_task_id > label_tasks.id [delete: cascade]
Ref: model_version_skus.model_version_id > model_versions.id [delete: cascade]
Ref: model_confusions.model_version_id > model_versions.id [delete: cascade]

// ---------------------------------------------------------------- references that keep one parent
// Composite keys make both sides of a link belong to the same batch.

Ref: model_versions.(train_job_id, batch_id) > jobs.(id, batch_id)
